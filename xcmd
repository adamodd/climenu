#!/bin/sh
# xcmd — run several commands at once; Ctrl-C stops them all.
#
#   xcmd 'npm run dev' 'python3 -m http.server' 'tail -f app.log'
#   xcmd -t ...    label each output line with the command it came from
#
# Each argument is one command; quote it if it has spaces or && in it.
#
# A thin wrapper around GNU parallel, which does the real work: it runs
# the commands side by side, gives them no keyboard input (so they can't
# fight over the terminal), and on Ctrl-C stops each one along with
# everything it started, then waits until they've all exited.

usage() {
  echo "usage: xcmd [-t] 'command 1' 'command 2' ..."
  echo "  -t   label each output line with the command it came from"
}

tag=
while getopts th opt; do
  case $opt in
    t) tag=--tag ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))

if [ $# -eq 0 ]; then
  usage >&2
  exit 2
fi

# The moreutils package has a different program also called "parallel".
if ! parallel --version 2>/dev/null | grep -q '^GNU parallel'; then
  echo "xcmd: needs GNU parallel (macOS: brew install parallel," >&2
  echo "      Debian/Ubuntu: apt install parallel)" >&2
  exit 127
fi

# --will-cite      skip GNU parallel's "please cite" notice
# --termseq ...    on Ctrl-C: ask each command to stop (TERM), allow up to
#                  5 s for a clean shutdown, then force it (KILL). The
#                  default allows only about 0.4 s.
# --line-buffer    print output as it arrives, whole lines at a time
# -j0              run every command at once, not a few at a time
exec parallel --will-cite --termseq TERM,5000,KILL,25 --line-buffer $tag -j0 ::: "$@"
